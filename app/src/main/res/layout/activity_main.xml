<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/login_background"
    android:gravity="center"
    android:padding="17dp">

    <!-- 상단 타이틀 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AI 학습플래너"
        android:textColor="#FFFFFF"
        android:textSize="32sp"
        android:textStyle="bold"
        android:layout_marginBottom="300dp"/>

    <!-- 소셜 로그인 아이콘 3개 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="30dp">

        <!-- 카카오톡 -->
        <LinearLayout
            android:id="@+id/kakaoLoginButton"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/social_button_background"
            android:gravity="center"
            android:layout_marginEnd="30dp"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/kakaoImage"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:scaleType="fitCenter"/>
        </LinearLayout>

        <!-- 구글 -->
        <LinearLayout
            android:id="@+id/googleLoginButton"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/social_button_background"
            android:gravity="center"
            android:layout_marginEnd="30dp"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/googleImage"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:scaleType="fitCenter"/>
        </LinearLayout>

        <!-- 네이버 -->
        <LinearLayout
            android:id="@+id/naverLoginButton"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/social_button_background"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/naverImage"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:scaleType="fitCenter"/>
        </LinearLayout>
    </LinearLayout>

    <!-- 하단 로그인/회원가입 텍스트 (세로 배치) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/loginText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="로그인"
            android:textColor="#000000"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"/>

        <TextView
            android:id="@+id/signupText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="회원가입"
            android:textColor="#000000"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"/>
    </LinearLayout>

</LinearLayout>