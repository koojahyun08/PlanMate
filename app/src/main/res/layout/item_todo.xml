<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/todoRootLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/todo_blue"
    android:orientation="vertical"
    android:padding="12dp"
    android:layout_marginBottom="16dp"
    android:elevation="1dp">

    <!-- 상단: 컬러바 + 휴지통 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <View
            android:id="@+id/todoColorBar"
            android:layout_width="22dp"
            android:layout_height="2dp"
            android:background="#6699FF"/>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <ImageView
            android:id="@+id/scheduleDeleteButton"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_delete"
            android:tint="#000000"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <!-- 제목 + 날짜 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="6dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/scheduleTitleText"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="일정 제목"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#000000"/>

        <TextView
            android:id="@+id/scheduleDateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2026.01.01"
            android:textSize="13sp"
            android:textColor="#888888"
            android:layout_marginEnd="6dp"/>
    </LinearLayout>

    <!-- 할 일 목록 -->
    <LinearLayout
        android:id="@+id/tasksContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"/>

    <!-- 수정 버튼 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/scheduleEditButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="수정"
            android:textSize="12sp"
            android:textColor="#A0A0A0"
            android:padding="4dp"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

</LinearLayout>