<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/todoRootLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:padding="14dp"
    android:background="@drawable/todo_pink">

    <!-- 기존 가로줄 위치를 체크박스로 대체 -->
    <CheckBox
        android:id="@+id/itemCheckBox"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:buttonTint="#666666"
        android:padding="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/scheduleDeleteButton"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="@android:drawable/ic_menu_delete"
        android:tint="#FF5555"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/itemCheckBox"
        app:layout_constraintBottom_toBottomOf="@id/itemCheckBox" />

    <TextView
        android:id="@+id/scheduleDateText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="삭제일: 2026-05-26"
        android:textSize="11sp"
        android:textColor="#888888"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toStartOf="@id/scheduleDeleteButton"
        app:layout_constraintTop_toTopOf="@id/itemCheckBox"
        app:layout_constraintBottom_toBottomOf="@id/itemCheckBox" />

    <TextView
        android:id="@+id/scheduleTitleText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="장기 학습 계획"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginTop="26dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/scheduleDateText"
        app:layout_constraintTop_toBottomOf="@id/itemCheckBox" />

    <LinearLayout
        android:id="@+id/tasksContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/scheduleTitleText" />

    <TextView
        android:id="@+id/scheduleRestoreButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="복원"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#4CAF50"
        android:padding="6dp"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tasksContainer" />

</androidx.constraintlayout.widget.ConstraintLayout>